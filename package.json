{
  "name": "exam-quiz",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd exam-quiz && npm run dev",
    "build": "cd exam-quiz && npm ci --no-audit --no-fund && npm run build && cd .. && rm -rf dist && cp -r exam-quiz/dist dist",
    "preview": "cd exam-quiz && npm run preview",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "gh-pages": "^6.3.0",
    "vite": "^5.0.0"
  }
}
